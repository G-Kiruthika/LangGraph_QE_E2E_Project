# ==========================================
# Google Gemini LLM Configuration
# ==========================================
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ==========================================
# Jira Integration Configuration
# ==========================================
# Domain URL for your Jira instance (e.g., https://your-domain.atlassian.net)
JIRA_DOMAIN=https://your-domain.atlassian.net

# Jira account email / username
JIRA_USERNAME=your_email@example.com

# Jira API token created from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_KEY=your_jira_api_token_here

# LangSmith Tracing (Optional but highly recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=QE-Automation-Graph
